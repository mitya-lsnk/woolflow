#!/command/with-contenv sh
# s6 longrun: hold the public port open so Render's healthcheck and the
# Free-tier idle watchdog see a listener. Hermes reaches Telegram over an
# outbound long-poll and opens nothing itself, so this is the container's only
# listener.
#
# The binary is scripts/port-stub.c, compiled at image build time. It costs
# ~1 MB RSS where the python3 http.server it replaced cost ~12-15 MB, and it
# prints the cgroup's memory usage to stderr every WOOLFLOW_MEM_INTERVAL
# seconds — the only view of real RAM use on Free, which has no metrics.
#
# If the dashboard is enabled it claims port 10000 itself, so we idle out
# instead of competing for the port.
if [ -n "${HERMES_DASHBOARD:-}" ] && [ "${HERMES_DASHBOARD}" != "0" ]; then
  exec sleep infinity
fi

exec /usr/local/bin/woolflow-port-stub
