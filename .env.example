# Hermes Agent on Render: environment variables
#
# This Blueprint deliberately keeps the env-var surface tiny. Only the
# vars listed below are managed by `render.yaml`. Provider keys, tool
# keys, and chat platform tokens are set through the Hermes dashboard
# (API Keys tab), which writes them to /opt/data/.env on the persistent
# disk. That file is the single source of truth, survives redeploys,
# and is the same UX as a local Hermes install.
#
# Full upstream env-var reference:
# https://github.com/NousResearch/hermes-agent/blob/main/.env.example

# =============================================================================
# Container boot config (set by the Blueprint, no user action needed)
# =============================================================================

# Dashboard side-process. OFF here: it is a second Python interpreter
# (~80-120 MB) and does not fit alongside the gateway in Free's 512 MB.
# Flip to 1 in the Render Dashboard for browser-based setup, Restart, finish,
# then set it back to 0.
HERMES_DASHBOARD=0

# Bind the dashboard to all interfaces so Render's load balancer can reach it,
# for the window while it is on. A non-loopback dashboard requires an auth
# provider: set HERMES_DASHBOARD_BASIC_AUTH_USERNAME + _PASSWORD, or
# HERMES_DASHBOARD_OAUTH_CLIENT_ID. HERMES_DASHBOARD_INSECURE no longer
# disables that gate.
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=10000

# Generated by the Blueprint at first deploy (generateValue: true). Reuse
# this value as API_SERVER_KEY (in the dashboard) if you opt into the
# OpenAI-compatible API server.
HERMES_GATEWAY_TOKEN=

# =============================================================================
# Memory profile (Render Free, 512 MB) — read at boot by scripts/boot-config.py
# =============================================================================
# Changing any of these is a Restart, not a rebuild. scripts/boot-config.py
# documents what each one costs.

# Set to 0 to skip the low-memory profile entirely and get stock Hermes
# behaviour — the right move on a paid plan with real headroom.
WOOLFLOW_LOWMEM=1

# Hard cap on simultaneously active chats (Hermes default: unbounded).
WOOLFLOW_MAX_CONCURRENT_SESSIONS=1

# LRU cap on cached-but-detached sessions (Hermes default: 16).
WOOLFLOW_MAX_LIVE_SESSIONS=2

# Toolsets stripped from every agent's schema. These 23 cover every tool in
# Hermes' core set, leaving the model with no tools at all: the character can
# neither offer nor run anything, and the two biggest memory risks (Playwright's
# 150-400 MB Chromium, and terminal/code execution inside a 512 MB cgroup) go
# with them. Inbound photos still reach the model — image input is a separate
# path from the vision toolset.
WOOLFLOW_DISABLED_TOOLSETS=browser,computer_use,terminal,code_execution,delegation,file,web,search,x_search,skills,cronjob,todo,clarify,session_search,context_engine,project,vision,video,video_gen,image_gen,tts,homeassistant,kanban

# Agent persona. soul/SOUL.md is baked into the image and reinstalled at
# $HERMES_HOME/SOUL.md on every boot, because Free reseeds the stock persona
# each wake-up. 0 = leave Hermes' seed alone; force = overwrite even a
# hand-edited SOUL.md.
WOOLFLOW_SOUL=1

# Strips Hermes' assistant framing out of the system prompt: the first-contact
# "introduce yourself and mention /help" note and its profile-build offer, the
# finishing-the-job and verification briefs, tool-batching guidance, and the
# Python/pip environment probe. 0 restores Hermes' defaults.
WOOLFLOW_PERSONA=1

# Scheduled jobs from cron/jobs.yaml, re-created on every boot because Free
# wipes $HERMES_HOME/cron/jobs.json on each spin-down. 0 installs none.
WOOLFLOW_CRON=1

# Chars of the memory store replayed into the prompt each turn (Hermes ships
# 2200 / 1375). Not a disk or RAM limit — this is context spent on every turn.
WOOLFLOW_MEMORY_CHARS=6000
WOOLFLOW_USER_MEMORY_CHARS=3000

# Where a job with deliver="telegram" is sent. From @userinfobot. Personal
# data — set it in Render's Environment tab, not here.
WOOLFLOW_TELEGRAM_CHAT_ID=

# Cron schedules are anchored to this, NOT the server clock (Render is UTC).
HERMES_TIMEZONE=UTC

# Runtime facts for the model, deliberately kept out of SOUL.md — upstream's
# slot for a host describing the environment without touching the identity.
# Set in render.yaml; see scripts/install-soul.sh for how the persona is
# installed and why it is kept out of SOUL.md.
# HERMES_ENVIRONMENT_HINT=

# Seconds between `[woolflow] mem used=...MiB limit=512MiB (..%)` lines from
# the port stub. Free has no metrics page, so this is the only view of real
# memory use. 0 silences it.
WOOLFLOW_MEM_INTERVAL=120

# NOTE: this fork does NOT ship the Render MCP server (each stdio MCP server is
# a resident subprocess). RENDER_MCP_API_KEY from the upstream template has no
# effect here.

# =============================================================================
# Everything else
# =============================================================================
# Set these from the Hermes dashboard (https://<your-service>.onrender.com),
# under the API Keys tab. Each entry shows a redacted preview, a description,
# and a link to the provider's signup page. Examples of what's available:
#
#   LLM providers (set at least one):
#     OPENROUTER_API_KEY, ANTHROPIC_API_KEY, OPENAI_API_KEY, GOOGLE_API_KEY,
#     HF_TOKEN, GLM_API_KEY, KIMI_API_KEY, OLLAMA_API_KEY, ...
#
#   Messaging platforms:
#     TELEGRAM_BOT_TOKEN, DISCORD_BOT_TOKEN, SLACK_BOT_TOKEN + SLACK_APP_TOKEN,
#     WHATSAPP_*, EMAIL_*, SIGNAL_*, TEAMS_*, GOOGLE_CHAT_*, ...
#
#   Tool API keys:
#     BROWSERBASE_API_KEY, EXA_API_KEY, FIRECRAWL_API_KEY, TAVILY_API_KEY,
#     HONCHO_API_KEY, GITHUB_TOKEN, ...
#
#   OpenAI-compatible API server (off by default):
#     API_SERVER_ENABLED, API_SERVER_KEY, API_SERVER_HOST, API_SERVER_CORS_ORIGINS
#
# If you'd rather set them via the Render Dashboard's Environment tab,
# that works too: Render env vars override values from /opt/data/.env at
# process start. Either path is fine; pick one and stick with it.
